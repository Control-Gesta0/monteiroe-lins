# === Kommo ===
KOMMO_DOMAIN=https://SUACONTA.kommo.com
# Token de LONGA DURAÇÃO: é um JWT e começa com "eyJ". A "chave secreta" de 64
# caracteres da mesma tela NÃO é token — dá 401 (kommo/PEGADINHAS.md §17).
KOMMO_TOKEN=
KOMMO_ACCOUNT_ID=
# Salesbot de ENVIO. Se a conta já tinha IA em n8n, reaproveite o MESMO bot e
# o MESMO campo de resposta (descubra o campo pelos eventos — scripts/discover.ts)
KOMMO_BOT_ID=

# === LLM (padrão da skill: GPT-5.4 Mini, Chat Completions, reasoning none) ===
OPENAI_API_KEY=
LLM_MODEL=gpt-5.4-mini-2026-03-17
VISION_MODEL=gpt-5.4-mini-2026-03-17
STT_MODEL=gpt-4o-mini-transcribe

# === Upstash Redis (OBRIGATÓRIO no Kommo: o histórico mora aqui) ===
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Database compartilhado entre clientes: prefixo ÚNICO por cliente
REDIS_PREFIX=ak-CLIENTE:

# === Operação ===
WEBHOOK_SECRET=            # openssl rand -hex 24 — NOVO por cliente
CLIENT_NAME="Cliente · Agente"
DEBOUNCE_SECONDS=10
# Gate: só atende lead com esta tag. Na migração do n8n use uma tag DISJUNTA
# (ex.: sofia) durante a rampagem; na virada troque para a tag do n8n.
GATE_TAG=
# Tag que desliga a IA quando um humano assume
HUMAN_TAG=atendimento-humano
# Contatos de teste que podem mandar "reset" (lead_ids separados por vírgula)
TEST_LEAD_IDS=

# === Só para scripts locais ===
DEPLOY_URL=
