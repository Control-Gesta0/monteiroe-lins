# URL pública do agente (alias de produção na Vercel, sem barra no fim)
AGENT_URL=https://lia-monteiro-lins.vercel.app
# CENTRAL_SECRET do agente (ou, enquanto a Central for só da agência, o WEBHOOK_SECRET)
AGENT_SECRET=
# Senha de acesso ao painel
APP_PASSWORD=
# Assina o cookie de sessão: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Só para ver o painel com dados fictícios (nunca em produção)
CENTRAL_DEMO=
